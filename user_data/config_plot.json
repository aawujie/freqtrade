{
	"$schema": "https://schema.freqtrade.io/schema.json",
	"exchange": {
		"name": "binance"
	},
	"plot_config": {
		"main_plot": {
			"sma20": { "color": "blue" },
			"ema50": { "color": "orange" },
			"ema200": { "color": "#888" }
		},
		"subplots": {
			"Volume": {
				"volume": { "type": "bar", "plotly": { "opacity": 0.4 } }
			},
			"RSI": {
				"rsi": { "color": "red" }
			},
			"MACD": {
				"macd": { "color": "blue" },
				"macdsignal": { "color": "red" },
				"macdhist": { "type": "bar", "plotly": { "opacity": 0.9 } }
			}
		}
	}
}


