{
  // 通用交易配置注释模板（仅说明用，不参与运行）
  // 优先级总则（高→低）：命令行/环境变量 > 配置文件(.json) > 策略文件

  "$schema": "https://schema.freqtrade.io/schema.json",

  // 基本
  "strategy": "YourStrategy", // 使用的策略类名
  "timeframe": "5m",          // K线周期（优先级：命令行 > 配置 > 策略）
  "dry_run": true,             // 模拟交易开关
  "dry_run_wallet": 1000,      // 模拟资金
  "max_open_trades": 3,        // 最大同时持仓数
  "tradable_balance_ratio": 0.99, // 可用资金比例
  "fiat_display_currency": "USD", // 显示法币
  "stake_currency": "USDT",   // 本位币
  "stake_amount": 100,         // 每笔金额（可为数字/百分比/"unlimited"）
  "trading_mode": "spot",     // 交易模式：spot / futures（显式声明，避免歧义）

  // 价格与委托
  "entry_pricing": {
    "price_side": "same",     // 买入：same=买盘价；other=卖盘价（更易成交）
    "use_order_book": true,
    "order_book_top": 1,
    "price_last_balance": 0,
    "check_depth_of_market": { "enabled": false, "bids_to_ask_delta": 1 }
  },
  "exit_pricing": 
  { 
    "price_side": "same",
    "use_order_book": true,
    "order_book_top": 1
  },

  // 订单未成交超时设置（避免长时间挂单）
  "unfilledtimeout": {
    "entry": 10,              // 买入单超过 10 分钟未成交就取消
    "exit": 10,               // 卖出单超过 10 分钟未成交就取消
    "exit_timeout_count": 0,  // 连续超时计数，0 表示不依赖次数
    "unit": "minutes"        // 时间单位：minutes / seconds
  },

  // 交易所
  "exchange": {
    "name": "binance",
    "pair_whitelist": [
        "BTC/USDT"
    ],
    "pair_blacklist": [],
    "ccxt_config": {},
    "ccxt_async_config": {}
  },

  // 交易对选择（pairlists）
  // 1) 静态白名单（新手/可控）：仅交易 exchange.pair_whitelist 中列出的交易对
  "pairlists": [
    { "method": "StaticPairList" }
  ],
  // 2) 动态成交量列表（进阶/自动化）：按交易量自动挑选前 N 个交易对（示例，取消注释即可使用）
  // "pairlists": [
  //   {
  //     "method": "VolumePairList",
  //     "number_assets": 20,        // 选择前 N 个
  //     "sort_key": "quoteVolume", // 排序依据：quoteVolume / volume / turnover 等
  //     "min_value": 0,             // 过滤低成交量
  //     "refresh_period": 1800      // 刷新周期（秒）
  //   }
  // ],

  // API / Web（若仅需要 REST，请开启 enabled 并限制端口暴露）
  "api_server": {
    "enabled": true,
    "listen_ip_address": "0.0.0.0",
    "listen_port": 8081,       // 交易/回测推荐固定 8081
    "verbosity": "error",
    "enable_openapi": false,
    "jwt_secret_key": "",
    "ws_token": "",
    "CORS_origins": [],
    "username": "freqtrader",
    "password": "123"
  },

  // 其他
  "bot_name": "your-bot-name", // 前端显示的实例名
  "initial_state": "running",  // 启动状态（对 trade 生效）：running/stopped
  "force_entry_enable": false,  // 允许在 UI/API 强制入场（绕过策略的买入条件，立即按当前配置下单）
  "internals": {
    "process_throttle_secs": 5 // 主循环“节流延时”最小休眠秒数：越小响应越快但CPU更高；1-2s低延迟，3-5s通用；不影响回测
  }
}


