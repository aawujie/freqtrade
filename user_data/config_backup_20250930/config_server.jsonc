{
	"$schema": "https://schema.freqtrade.io/schema.json", // 仅用于编辑器/校验提示，不影响运行

	// 仅为通过 webserver 启动校验而设定的最小交易所名称（不交易）
	"exchange": {
		"name": "binance" // 任一受支持交易所名均可；webserver 需要该字段通过校验
	},

	// Telegram 通知（只要 webserver 需要推送，就在 .env 中填入 TOKEN/CHAT_ID）
	"telegram": {
		"enabled": true, // 开启/关闭 Telegram 通知
		"token": "${FREQTRADE__TELEGRAM__TOKEN}", // 从环境变量读取，避免明文
		"chat_id": "${FREQTRADE__TELEGRAM__CHAT_ID}" // 接收消息的聊天ID
	},

	// API / Web UI 服务配置（本文件定位：webserver 固定使用 8080）
	"api_server": {
		"enabled": true, // 启用 REST API + Web UI
		"listen_ip_address": "0.0.0.0", // 监听地址：0.0.0.0 对外可访问；127.0.0.1 仅本机
		"listen_port": 8080, // 端口：compose 已映射 8080:8080
		"verbosity": "error", // API 日志级别：debug/info/warning/error
		"enable_openapi": false, // 是否暴露交互式 OpenAPI 文档（出于安全默认关闭）
		"jwt_secret_key": "${FREQTRADE__API_SERVER__JWT_SECRET_KEY}", // JWT 签名密钥（务必为强随机）
		"ws_token": "${FREQTRADE__API_SERVER__WS_TOKEN}", // WebSocket 鉴权可选令牌
		"CORS_origins": [], // 需要跨域访问的来源（如有前后端分离再配置）
		"username": "freqtrader", // 登录用户名（请改为自定义强口令）
		"password": "123" // 登录密码（请改为强密码）
	},

	"bot_name": "freqtrade-web", // 在前端显示的实例名，仅用于识别该 Web 实例

	"initial_state": "running", // 启动状态：
	// - "running": 进程启动后处于 RUNNING（对 trade 生效，webserver 本身不交易）
	// - "stopped": 进程启动后处于 STOPPED，需在 UI/API 中手动切换为运行

	"internals": {
		"process_throttle_secs": 5 // 内部轮询节流秒数，降低无意义的高频循环
	}
}


