{
	"$schema": "https://schema.freqtrade.io/schema.json",
	"_comment": "ichiV1 策略模块化配置 - 引用通用配置模块",
	
	"add_config_files": [
		"configs/config_base.json",
		"configs/config_secrets.json",
		"configs/config_pairs_futures.json",
		"configs/config_webhook.json",
		"configs/config_api_server.json",
		"configs/config_plot_ichimoku.json"
	],
	
	"_override_comment": "以下参数会覆盖通用配置中的默认值",
	
	"strategy": "ichiV1",
	"timeframe": "5m",
	"force_entry_enable": true,
	
	"_trading_params": "覆盖 config_base.json 中的参数",
	"dry_run_wallet": 100,
	"max_open_trades": 5,
	"stake_amount": 20,
	"amend_last_stake_amount": true,
	
	"_pairs_override": "覆盖通用合约交易对配置",
	"exchange": {
		"pair_whitelist": [
			"BTC/USDT:USDT",
			"ETH/USDT:USDT",
			"BNB/USDT:USDT",
			"DOGE/USDT:USDT"
		],
		"pair_blacklist": [
			"LINK/USDT:USDT",
			"LTC/USDT:USDT",
			"SOL/USDT:USDT",
			"XRP/USDT:USDT",
			"ADA/USDT:USDT",
			"DOT/USDT:USDT",
			"BCH/USDT:USDT",
			"ALGO/USDT:USDT",
			"LUNA/USDT:USDT",
			"ASTER/USDT:USDT"
		]
	},
	
	"_api_override": "使用端口 8080（覆盖默认）",
	"api_server": {
		"listen_port": 8080
	},
	
	"bot_name": "ichiV1",
	"initial_state": "running",
	"db_url": "sqlite:///database/trades_ichiV1.sqlite",
	"logfile": "logs/freqtrade_ichiV1_8081.log",
	
	"internals": {
		"process_throttle_secs": 5
	}
}
