{
	"$schema": "https://schema.freqtrade.io/schema.json",
	"_comment": "通用 Webhook 通知配置 - 适用于所有策略",
	"_how_to_use": "在策略配置中引用此文件，可通过 webhook.enabled 控制是否启用",
	
	"webhook": {
		"enabled": true,
		"url": "${FREQTRADE__WEBHOOK__URL}",
		"format": "json",
		"retries": 3,
		"retry_delay": 0.1,
		
		"_startup": "机器人启动通知",
		"startup": {
			"msg_type": "text",
			"content": {
				"text": "🚀 Freqtrade 已启动\n策略: {strategy}\n状态: {status}"
			}
		},
		
		"_warning": "警告通知",
		"warning": {
			"msg_type": "text",
			"content": {
				"text": "⚠️ 警告\n{status}"
			}
		},
		
		"_status": "状态更新通知",
		"status": {
			"msg_type": "text",
			"content": {
				"text": "📊 状态更新\n{status}"
			}
		},
		
		"_entry": "买入通知",
		"entry": {
			"msg_type": "text",
			"content": {
				"text": "🟢 BUY {pair} @ {limit:.8f}\n投入: {stake_amount:.8f} {stake_currency}\n策略: {strategy}\n时间: {date}"
			}
		},
		
		"_entry_fill": "买入成交通知",
		"entry_fill": {
			"msg_type": "text",
			"content": {
				"text": "✅ Entry Filled\n交易对: {pair}\n成交价: {open_rate:.8f}\n数量: {amount:.8f}\n成本: {stake_amount:.8f} {stake_currency}"
			}
		},
		
		"_entry_cancel": "买入取消通知",
		"entry_cancel": {
			"msg_type": "text",
			"content": {
				"text": "❌ Entry Cancelled\n交易对: {pair}\n原因: {reason}"
			}
		},
		
		"_exit": "卖出通知",
		"exit": {
			"msg_type": "text",
			"content": {
				"text": "🔴 SELL {pair} @ {limit:.8f}\nPnL: {profit_amount:.8f} {stake_currency} ({profit_ratio:.2%})\n原因: {exit_reason}"
			}
		},
		
		"_exit_fill": "卖出成交通知",
		"exit_fill": {
			"msg_type": "text",
			"content": {
				"text": "💰 Exit Filled\n交易对: {pair}\n成交价: {close_rate:.8f}\n收益: {profit_amount:.8f} {stake_currency} ({profit_ratio:.2%})\n持仓: {duration}"
			}
		},
		
		"_exit_cancel": "卖出取消通知",
		"exit_cancel": {
			"msg_type": "text",
			"content": {
				"text": "❌ Exit Cancelled\n交易对: {pair}\n原因: {reason}"
			}
		},
		
		"_protection_trigger": "保护触发通知",
		"protection_trigger": {
			"msg_type": "text",
			"content": {
				"text": "🛡️ Protection Triggered\n类型: {protection}\n交易对: {pair}"
			}
		},
		
		"_protection_trigger_global": "全局保护触发",
		"protection_trigger_global": {
			"msg_type": "text",
			"content": {
				"text": "🛡️ Global Protection\n类型: {protection}"
			}
		}
	},
	
	"_usage_notes": [
		"✅ 通用配置，适用于所有策略",
		"✅ 支持企业微信、钉钉、飞书等 Webhook",
		"✅ 在策略配置中可覆盖 enabled 参数控制启用/禁用",
		"✅ 可在策略配置中覆盖消息格式",
		"",
		"设置环境变量:",
		"export FREQTRADE__WEBHOOK__URL='your_webhook_url'",
		"",
		"企业微信: https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=YOUR_KEY",
		"钉钉: https://oapi.dingtalk.com/robot/send?access_token=YOUR_TOKEN",
		"飞书: https://open.feishu.cn/open-apis/bot/v2/hook/YOUR_HOOK",
		"",
		"可用变量: https://www.freqtrade.io/en/stable/webhook-config/"
	]
}
