{
	"_comment": "双均线策略绘图配置 - 适用于 DoubleMAStrategy",
	
	"exchange": {
		"name": "binance"
	},
	
	"plot_config": {
		"main_plot": {
			"_comment": "双均线和趋势线配置",
			
			"fast_ma": {
				"color": "blue",
				"type": "line"
			},
			"slow_ma": {
				"color": "red",
				"type": "line"
			},
			"trend_line": {
				"color": "#888888",
				"type": "line"
			},
			
			"bb_upperband": {
				"color": "rgba(100,100,255,0.3)",
				"fill_to": "bb_lowerband",
				"fill_color": "rgba(100,100,255,0.1)"
			},
			"bb_middleband": {
				"color": "rgba(100,100,255,0.5)"
			},
			"bb_lowerband": {
				"color": "rgba(100,100,255,0.3)"
			}
		},
		
		"subplots": {
			"Volume": {
				"volume": {
					"color": "rgba(100,100,255,0.4)",
					"type": "bar",
					"plotly": {
						"opacity": 0.4
					}
				},
				"volume_ma": {
					"color": "orange",
					"type": "line"
				}
			},
			
			"RSI": {
				"rsi": {
					"color": "purple"
				}
			},
			
			"MACD": {
				"macd": {
					"color": "blue"
				},
				"macdsignal": {
					"color": "red"
				},
				"macdhist": {
					"type": "bar",
					"plotly": {
						"opacity": 0.5
					}
				}
			}
		}
	},
	
	"_usage": "使用方法：freqtrade plot-dataframe --config user_data/configs/config_plot_double_ma.json --strategy DoubleMAStrategy --pairs BTC/USDT"
}
