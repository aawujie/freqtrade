{
	"$schema": "https://schema.freqtrade.io/schema.json",
	"_comment": "通用合约交易对配置 - 适用于所有合约策略",
	"_how_to_use": "在策略配置中引用此文件，可覆盖 exchange.pair_whitelist 自定义交易对",
	
	"trading_mode": "futures",
	"margin_mode": "isolated",
	
	"exchange": {
		"name": "binance",
		"_pair_whitelist_comment": "默认主流币种，策略配置可覆盖",
		"pair_whitelist": [
			"BTC/USDT:USDT",
			"ETH/USDT:USDT",
			"BNB/USDT:USDT",
			"SOL/USDT:USDT",
			"XRP/USDT:USDT",
			"ADA/USDT:USDT",
			"DOGE/USDT:USDT",
			"DOT/USDT:USDT",
			"MATIC/USDT:USDT",
			"LTC/USDT:USDT"
		],
		"_pair_blacklist_comment": "常见问题币种，策略配置可追加",
		"pair_blacklist": [
			"(BTCDOM|DEFI)/.*",
			".*(_PREMIUM|BEAR|BULL|DOWN|HALF|HEDGE|UP|[1235][SL])/.*"
		],
		"ccxt_config": {},
		"ccxt_async_config": {}
	},
	
	"_usage_notes": [
		"✅ 通用合约配置，适用于所有合约策略",
		"✅ 提供默认主流币种白名单",
		"✅ 在策略配置中可覆盖/追加交易对",
		"",
		"覆盖交易对示例:",
		"\"exchange\": {",
		"  \"pair_whitelist\": [\"BTC/USDT:USDT\", \"ETH/USDT:USDT\"]",
		"}",
		"",
		"追加黑名单示例:",
		"\"exchange\": {",
		"  \"pair_blacklist\": [\"LINK/USDT:USDT\", \"ALGO/USDT:USDT\"]",
		"}"
	]
}
